# ============================================================
# vLLM Service — Docker image for HunyuanOCR & Qwen3-4B
# Uses official vllm/vllm-openai image + reuses host HuggingFace cache
# ============================================================

FROM vllm/vllm-openai:latest

# Reuse HuggingFace cache from host (mount at docker-compose.yml)
# Models will be downloaded on first run and cached at ~/.cache/huggingface

EXPOSE 8001 8088