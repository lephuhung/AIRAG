# HRAG — Dev/Production services with Workers + Traefik
# Usage:
#   Development: APP_ENV=development docker compose -f docker-compose.services.yml up -d
#   Production: APP_ENV=production docker compose -f docker-compose.services.yml up -d
#
# Domains (add to /etc/hosts):
#   127.0.0.1 service.hatinh.local  (backend)
#   127.0.0.1 rag.hatinh.local      (frontend)
#   127.0.0.1 minio.hatinh.local    (MinIO console)

x-app-env: &app_env
  APP_ENV: ${APP_ENV:-development}

x-build-args: &build_args
  build:
    context: .
    args:
      TARGET: ${APP_ENV:-development}

networks:
  hrag_network:
    driver: bridge

services:
  # ── Traefik Reverse Proxy ───────────────────────────────────────────
  traefik:
    image: traefik:v3.0
    container_name: hrag-traefik
    command:
      - "--configFile=/etc/traefik/traefik.yml"
    ports:
      - "80:80"       # HTTP entrypoint
      - "8089:8080"   # Traefik dashboard (insecure)
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - hrag_traefik_data:/letsencrypt
    networks:
      - hrag_network
    restart: unless-stopped
    labels:
      com.hrag.service: traefik
      com.hrag.stack: hrag

  # ═══════════════════════════════════════════════════════════════════
  # INFRASTRUCTURE
  # ═══════════════════════════════════════════════════════════════════

  postgres:
    image: pgvector/pgvector:pg15
    container_name: hrag-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: hrag
    ports:
      - "5433:5432"
    volumes:
      - hrag_postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - hrag_network
    labels:
      com.hrag.service: postgres
      com.hrag.stack: hrag

  chromadb:
    image: chromadb/chroma:latest
    container_name: hrag-chromadb
    ports:
      - "8002:8000"
    volumes:
      - hrag_chroma_data:/data
    environment:
      - IS_PERSISTENT=TRUE
      - ANONYMIZED_TELEMETRY=FALSE
    networks:
      - hrag_network
    labels:
      com.hrag.service: chromadb
      com.hrag.stack: hrag

  rabbitmq:
    image: rabbitmq:3-management-alpine
    container_name: hrag-rabbitmq
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      RABBITMQ_DEFAULT_USER: guest
      RABBITMQ_DEFAULT_PASS: guest
    volumes:
      - hrag_rabbitmq_data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    networks:
      - hrag_network
    labels:
      com.hrag.service: rabbitmq
      com.hrag.stack: hrag

  minio:
    image: minio/minio:latest
    container_name: hrag-minio
    command: server /data --console-address ":9001"
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
      MINIO_NOTIFY_WEBHOOK_ENABLE_NEXUSRAG: "on"
      MINIO_NOTIFY_WEBHOOK_ENDPOINT_NEXUSRAG: http://host.docker.internal:8080/api/v1/minio/events
    volumes:
      - hrag_minio_data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - hrag_network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.minio.rule=Host(`minio.hatinh.local`)"
      - "traefik.http.routers.minio.entrypoints=http"
      - "traefik.http.services.minio.loadbalancer.server.port=9000"
      - "com.hrag.service=minio"
      - "com.hrag.stack=hrag"

  neo4j:
    image: neo4j:5-community
    container_name: hrag-neo4j
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      NEO4J_AUTH: neo4j/hrag12345
      NEO4J_PLUGINS: '["apoc"]'
      NEO4J_dbms_security_procedures_unrestricted: apoc.*
      NEO4J_dbms_memory_heap_initial__size: 512m
      NEO4J_dbms_memory_heap_max__size: 1G
    volumes:
      - hrag_neo4j_data:/data
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:7474 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - hrag_network
    labels:
      com.hrag.service: neo4j
      com.hrag.stack: hrag

  # ═══════════════════════════════════════════════════════════════════
  # VLLM SERVICES — GPU 1
  # ═══════════════════════════════════════════════════════════════════

  vllm-ocr:
    build:
      context: .
      dockerfile: Dockerfile.vllm
    container_name: hrag-vllm-ocr
    ports:
      - "8001:8001"
    environment:
      NVIDIA_VISIBLE_DEVICES: "1"
    volumes:
      - ~/.cache/huggingface:/root/.cache/huggingface
    command:
      - tencent/HunyuanOCR
      - --port
      - "8001"
      - --max-model-len
      - "25384"
      - --gpu-memory-utilization
      - "0.4"
      - --trust-remote-code
      - --served-model-name
      - hunyuan-ocr
      - --host
      - 0.0.0.0
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8001/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - hrag_network
    labels:
      com.hrag.service: vllm-ocr
      com.hrag.stack: hrag

  vllm-memory:
    build:
      context: .
      dockerfile: Dockerfile.vllm
    container_name: hrag-vllm-memory
    ports:
      - "8088:8088"
    environment:
      NVIDIA_VISIBLE_DEVICES: "1"
    volumes:
      - ~/.cache/huggingface:/root/.cache/huggingface
    command:
      - Qwen/Qwen3-4B-Instruct-2507-FP8
      - --port
      - "8088"
      - --max-model-len
      - "25000"
      - --gpu-memory-utilization
      - "0.3"
      - --trust-remote-code
      - --served-model-name
      - qwen-memory
      - --host
      - 0.0.0.0
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8088/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - hrag_network
    labels:
      com.hrag.service: vllm-memory
      com.hrag.stack: hrag

  # ═══════════════════════════════════════════════════════════════════
  # BACKEND & FRONTEND — Dev/Prod via APP_ENV
  # ═══════════════════════════════════════════════════════════════════

  # ── Backend API server ─────────────────────────────────────────────
  backend:
    <<: *build_args
    <<: *app_env
    container_name: hrag-backend
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      chromadb:
        condition: service_started
      minio:
        condition: service_healthy
      neo4j:
        condition: service_healthy
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/hrag
      CHROMA_HOST: chromadb
      CHROMA_PORT: 8000
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      MINIO_ENDPOINT: http://minio:9000
      MINIO_WEBHOOK_ENABLED: "false"
      NEO4J_URI: bolt://neo4j:7687
      CUDA_VISIBLE_DEVICES: "0"
      OPENAI_COMPATIBLE_BASE_URL: http://vllm-memory:8088/v1
    # Development: mount source code for --reload
    volumes:
      - ./backend:/app/backend:rw
      - hrag_uploads:/app/backend/uploads
      - hrag_data:/app/backend/data
    ports:
      - "8080:8080"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.backend.rule=Host(`service.hatinh.local`)"
      - "traefik.http.routers.backend.entrypoints=http"
      - "traefik.http.services.backend.loadbalancer.server.port=8080"
      - "com.hrag.service=backend"
      - "com.hrag.stack=hrag"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["0"]
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - hrag_network
    restart: unless-stopped

  # ── Frontend ─────────────────────────────────────────────────────────
  frontend:
    <<: *build_args
    <<: *app_env
    container_name: hrag-frontend
    depends_on:
      backend:
        condition: service_healthy
    # Development: mount source for hot reload
    volumes:
      - ./frontend:/app:rw
    ports:
      - "5174:5174"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.frontend.rule=Host(`rag.hatinh.local`)"
      - "traefik.http.routers.frontend.entrypoints=http"
      - "traefik.http.services.frontend.loadbalancer.server.port=5174"
      - "com.hrag.service=frontend"
      - "com.hrag.stack=hrag"
    networks:
      - hrag_network
    restart: unless-stopped

  # ── minio-init ────────────────────────────────────────────────────────
  minio-init:
    image: minio/mc:latest
    container_name: hrag-minio-init
    depends_on:
      minio:
        condition: service_healthy
      backend:
        condition: service_healthy
    entrypoint: >
      /bin/sh -c "
        mc alias set local http://minio:9000 minioadmin minioadmin;
        mc mb --ignore-existing local/hrag-uploads;
        mc mb --ignore-existing local/hrag-markdown;
        mc event add --ignore-existing local/hrag-uploads
          arn:minio:sqs::HRAG:webhook --event put;
        mc anonymous set-json /dev/stdin local/hrag-uploads <<'CORS'
        {
          \"CORSRules\": [{
            \"AllowedOrigins\": [\"*\"],
            \"AllowedMethods\": [\"PUT\", \"GET\", \"HEAD\"],
            \"AllowedHeaders\": [\"*\"],
            \"ExposeHeaders\": [\"ETag\"],
            \"MaxAgeSeconds\": 3000
          }]
        }
        CORS
        exit 0
      "
    restart: on-failure
    networks:
      - hrag_network

  # ═══════════════════════════════════════════════════════════════════
  # WORKERS
  # ═══════════════════════════════════════════════════════════════════

  worker-parse:
    <<: *build_args
    <<: *app_env
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      minio:
        condition: service_healthy
      vllm-ocr:
        condition: service_healthy
      vllm-memory:
        condition: service_healthy
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/hrag
      CHROMA_HOST: chromadb
      CHROMA_PORT: 8000
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      MINIO_ENDPOINT: http://minio:9000
      MINIO_WEBHOOK_ENABLED: "false"
      NEO4J_URI: bolt://neo4j:7687
      WORKER_TYPE: parse
      AUTO_CREATE_TABLES: "false"
      CUDA_VISIBLE_DEVICES: "0"
      HRAG_EAGER_MODEL_LOADING: "false"
      NEXUSRAG_DOCLING_DEVICE: cuda
      WORKER_DRAIN_TIMEOUT: "30"
      WORKER_HEALTH_PORT: "8081"
      HUNYUAN_OCR_API_URL: http://vllm-ocr:8001/v1
      MEMORY_AGENT_BASE_URL: http://vllm-memory:8088/v1
      OPENAI_COMPATIBLE_BASE_URL: http://vllm-memory:8088/v1
    volumes:
      - ./backend:/app/backend:rw
      - hrag_uploads:/app/backend/uploads
      - hrag_data:/app/backend/data
    deploy:
      replicas: 1
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]
    stop_grace_period: 60s
    command: ["python", "-m", "app.workers.runner"]
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    ports:
      - "8082:8081"
    networks:
      - hrag_network
    labels:
      com.hrag.service: worker-parse
      com.hrag.stack: hrag

  worker-embed:
    <<: *build_args
    <<: *app_env
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      chromadb:
        condition: service_started
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/hrag
      CHROMA_HOST: chromadb
      CHROMA_PORT: 8000
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      MINIO_ENDPOINT: http://minio:9000
      MINIO_WEBHOOK_ENABLED: "false"
      WORKER_TYPE: embed
      AUTO_CREATE_TABLES: "false"
      CUDA_VISIBLE_DEVICES: "0"
      HRAG_EAGER_MODEL_LOADING: "false"
      NEXUSRAG_EMBEDDING_DEVICE: cuda
      WORKER_DRAIN_TIMEOUT: "30"
      WORKER_HEALTH_PORT: "8081"
      MEMORY_AGENT_BASE_URL: http://vllm-memory:8088/v1
      WORKER_EMBED_TIMEOUT: "300"
      HRAG_CONTEXTUAL_CONCURRENCY: "16"
      OPENAI_COMPATIBLE_BASE_URL: http://vllm-memory:8088/v1
    volumes:
      - ./backend:/app/backend:rw
      - hrag_uploads:/app/backend/uploads
      - hrag_data:/app/backend/data
    deploy:
      replicas: 1
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["1"]
              capabilities: [gpu]
    stop_grace_period: 60s
    command: ["python", "-m", "app.workers.runner"]
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    ports:
      - "8083:8081"
    networks:
      - hrag_network
    labels:
      com.hrag.service: worker-embed
      com.hrag.stack: hrag

  worker-caption:
    <<: *build_args
    <<: *app_env
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      chromadb:
        condition: service_started
      minio:
        condition: service_healthy
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/hrag
      CHROMA_HOST: chromadb
      CHROMA_PORT: 8000
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      MINIO_ENDPOINT: http://minio:9000
      MINIO_WEBHOOK_ENABLED: "false"
      WORKER_TYPE: caption
      AUTO_CREATE_TABLES: "false"
      CUDA_VISIBLE_DEVICES: "0"
      WORKER_DRAIN_TIMEOUT: "30"
      WORKER_HEALTH_PORT: "8081"
    volumes:
      - ./backend:/app/backend:rw
      - hrag_uploads:/app/backend/uploads
      - hrag_data:/app/backend/data
    stop_grace_period: 60s
    command: ["python", "-m", "app.workers.runner"]
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    ports:
      - "8084:8081"
    networks:
      - hrag_network
    labels:
      com.hrag.service: worker-caption
      com.hrag.stack: hrag

  worker-kg:
    <<: *build_args
    <<: *app_env
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      neo4j:
        condition: service_healthy
      vllm-memory:
        condition: service_healthy
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/hrag
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
      NEO4J_URI: bolt://neo4j:7687
      WORKER_TYPE: kg
      AUTO_CREATE_TABLES: "false"
      CUDA_VISIBLE_DEVICES: "0"
      WORKER_DRAIN_TIMEOUT: "30"
      WORKER_HEALTH_PORT: "8081"
      LEGAL_KG_LLM_BASE_URL: http://vllm-memory:8088/v1
      OPENAI_COMPATIBLE_BASE_URL: http://vllm-memory:8088/v1
    volumes:
      - ./backend:/app/backend:rw
      - hrag_data:/app/backend/data
    stop_grace_period: 60s
    command: ["python", "-m", "app.workers.runner"]
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    ports:
      - "8085:8081"
    networks:
      - hrag_network
    labels:
      com.hrag.service: worker-kg
      com.hrag.stack: hrag

  # ═══════════════════════════════════════════════════════════════════
  # OBSERVABILITY — Loki + Grafana + Promtail
  # ═══════════════════════════════════════════════════════════════════

  loki:
    image: grafana/loki:3.2.0
    container_name: hrag-loki
    ports:
      - "3100:3100"
    volumes:
      - hrag_loki_data:/var/loki
    restart: unless-stopped
    networks:
      - hrag_network

  promtail:
    image: grafana/promtail:3.2.0
    container_name: hrag-promtail
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - ./infra/promtail:/etc/promtail:ro
      - hrag_promtail_positions:/tmp/promtail
    command: -config.file=/etc/promtail/config.yml
    restart: unless-stopped
    depends_on:
      loki:
        condition: service_started
    networks:
      - hrag_network

  grafana:
    image: grafana/grafana:11.2.0
    container_name: hrag-grafana
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin123
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - hrag_grafana_data:/var/lib/grafana
      - ./infra/grafana/provisioning:/etc/grafana/provisioning:ro
    restart: unless-stopped
    depends_on:
      - loki
    networks:
      - hrag_network

volumes:
  hrag_postgres_data:
  hrag_chroma_data:
  hrag_rabbitmq_data:
  hrag_minio_data:
  hrag_neo4j_data:
  hrag_uploads:
  hrag_data:
  hrag_loki_data:
  hrag_grafana_data:
  hrag_promtail_positions:
  hrag_traefik_data: