# =============================================================================
# NexusRAG — Environment Configuration
# Copy file này thành .env và chỉnh sửa theo môi trường của bạn
# =============================================================================


# =============================================================================
# INFRASTRUCTURE — Services
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hrag

# ChromaDB (vector store)
CHROMA_HOST=localhost
CHROMA_PORT=8002

# Redis (shared cross-process state — enables running >1 backend worker/replica)
# When REDIS_ENABLED=false (default) the backend keeps its single-process
# behaviour and never connects. Set to true (with the redis service up) to get
# a cross-process Stop button, and later the shared GPU semaphore + retrieval cache.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Backend worker processes (uvicorn --workers). Default 1 = single-process.
# To scale out: build the production image (APP_ENV=production), set
# WEB_CONCURRENCY>1, REDIS_ENABLED=true, ensure GPU headroom for N× retrieval
# models, and run migrations once (1 worker) then set AUTO_CREATE_TABLES=false.
WEB_CONCURRENCY=1

# GPU search concurrency guard (shared VRAM). Tier 1 = per-process; Tier 2 =
# cluster-wide (only when REDIS_ENABLED). GLOBAL=0 disables the distributed tier.
HRAG_SEARCH_GPU_CONCURRENCY=2
HRAG_SEARCH_GPU_GLOBAL_CONCURRENCY=2
HRAG_SEARCH_GPU_PERMIT_TTL=120
HRAG_SEARCH_GPU_WAIT_TIMEOUT=30

# RabbitMQ (task queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MinIO (object storage — raw uploads + parsed markdown)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=hrag-uploads
MINIO_BUCKET_MARKDOWN=hrag-markdown
MINIO_SECURE=false
# false = publish ParseMessage ngay sau upload (dev, không cần webhook)
# true  = chờ MinIO S3 event webhook tại /api/v1/minio/events (production)
MINIO_WEBHOOK_ENABLED=false
# URL MinIO mà browser có thể reach trực tiếp (dùng cho presigned PUT URL)
# Docker local dev: http://localhost:9000
# Production server: http://your-server-ip:9000 hoặc https://minio.yourdomain.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000


# =============================================================================
# LLM — Chat, Caption, KG extraction (qua proxy)
# Tất cả worker đều gọi qua proxy OpenAI-compatible tại host.docker.internal:20128.
# Đổi model thật trên proxy (bằng tên alias bên dưới) — KHÔNG cần rebuild/restart.
# =============================================================================

LLM_PROVIDER=openai_compatible

# --- Main LLM (chat, caption ảnh/bảng, answer generation) ---
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_COMPATIBLE_MODEL=airag-main
OPENAI_COMPATIBLE_API_KEY=your-proxy-api-key

# --- Memory Agent (classify, contextual embed, KG extract, memory facts) ---
# Dùng CHUNG proxy nhưng model alias khác — có thể route sang model nhỏ hơn.
MEMORY_AGENT_BASE_URL=http://host.docker.internal:20128/v1
MEMORY_AGENT_MODEL=airag-memory
MEMORY_AGENT_API_KEY=your-proxy-api-key

# --- LegalKG Extraction LLM ---
LEGAL_KG_LLM_PROVIDER=openai_compatible
LEGAL_KG_LLM_BASE_URL=http://host.docker.internal:20128/v1
LEGAL_KG_LLM_MODEL=airag-memory
LEGAL_KG_LLM_API_KEY=your-proxy-api-key

# --- Graphiti (personal-memory fact extraction) ---
GRAPHITI_LLM_BASE_URL=http://host.docker.internal:20128/v1
GRAPHITI_LLM_MODEL=airag-memory
GRAPHITI_LLM_API_KEY=your-proxy-api-key

# --- OpenViking (context-DB memory backend cho LangGraph agents) ---
# Backend selector: graphiti (default) | openviking | both | none
#   - graphiti   : hành vi hiện tại (Neo4j temporal KG)
#   - openviking : dùng OpenViking server làm trí nhớ (bật LangGraph qua
#                  NEXUSRAG_AGENT_BACKEND=langgraph)
#   - both       : ghi cả hai, đọc merge (OpenViking trước, Graphiti sau)
#   - none       : tắt memory
NEXUSRAG_MEMORY_BACKEND=graphiti
# URL của OpenViking server (để trống = tắt OpenViking). Trong compose:
# http://openviking:1933; chạy host-only: http://localhost:1933
OPENVIKING_URL=http://openviking:1933
# Root/API key của OpenViking server (tương ứng root_api_key trong ov.conf)
OPENVIKING_API_KEY=your-openviking-root-key
OPENVIKING_ACCOUNT=nexusrag
OPENVIKING_TIMEOUT=30.0
OPENVIKING_TOP_K=5
# OPENVIKING_SCORE_THRESHOLD=

# LLM của OpenViking server (viết vào ov.conf qua OPENVIKING_CONF_CONTENT trong
# docker-compose.services.yml) dùng chung proxy memory agent của hệ thống:
OPENVIKING_VLM_BASE_URL=http://host.docker.internal:20128/v1
OPENVIKING_VLM_MODEL=airag-memory
OPENVIKING_VLM_API_KEY=sk-nexusrag

# Embedding cho OpenViking: trỏ vào embed-rerank service (endpoint /v1/embeddings
# OpenAI-compatible vừa thêm) để dùng chung model embedding của RAG (1024-dim).
OPENVIKING_EMBED_BASE_URL=http://embed-rerank:8090/v1
OPENVIKING_EMBED_MODEL=vietlegal-harrier
OPENVIKING_EMBED_API_KEY=sk-none

# Giới hạn output tokens
LLM_MAX_OUTPUT_TOKENS=4096

# --- Gemini (inactive — bỏ comment nếu muốn switch) ---
# LLM_PROVIDER=gemini
# GOOGLE_AI_API_KEY=your-api-key-here
# LLM_MODEL_FAST=gemini-2.5-flash

# --- Ollama (inactive — native Ollama protocol, KHÁC với proxy /v1 OpenAI) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_ENABLE_THINKING=false
# =============================================================================
# KG EMBEDDING — Vector embedding cho Knowledge Graph (LightRAG)
# Có thể dùng provider khác với LLM provider ở trên
# =============================================================================

# local  → sentence-transformers trực tiếp trên máy (khuyến nghị khi không có Gemini key)
# gemini → Gemini Embedding API (cần GOOGLE_AI_API_KEY)
# ollama → Ollama embedding API (remote host ở trên phải có embedding endpoint)
# Dùng CHUNG model embedding với RAG (HRAG_EMBEDDING_MODEL) — LocalEmbeddingProvider
# sẽ tái dùng EmbeddingService singleton đã nạp sẵn → KHÔNG nạp thêm model thứ 2 (tiết kiệm VRAM).
# Chỉ có tác dụng khi HRAG_KG_MODE=lightrag (mode mặc định `legal` không dùng embedding).
KG_EMBEDDING_PROVIDER=local
KG_EMBEDDING_MODEL=mainguyen9/vietlegal-harrier-0.6b
KG_EMBEDDING_DIMENSION=1024

# --- Gemini embedding (inactive) ---
# KG_EMBEDDING_PROVIDER=gemini
# KG_EMBEDDING_MODEL=gemini-embedding-001
# KG_EMBEDDING_DIMENSION=3072


# =============================================================================
# PIPELINE — Document ingestion
# =============================================================================

# Bật/tắt các tính năng
HRAG_ENABLED=true
HRAG_ENABLE_KG=true
HRAG_ENABLE_IMAGE_EXTRACTION=true
HRAG_ENABLE_IMAGE_CAPTIONING=true
HRAG_ENABLE_TABLE_CAPTIONING=true
# Tắt CodeFormulaV2 VLM (~1.5 GB VRAM) khi không cần nhận dạng công thức toán
HRAG_ENABLE_FORMULA_ENRICHMENT=true

# Chunking
HRAG_CHUNK_MAX_TOKENS=512

# Knowledge Graph
HRAG_KG_LANGUAGE=Vietnamese
HRAG_KG_ENTITY_TYPES=["Organization","Person","Product","Location","Event","Financial_Metric","Technology","Date","Regulation"]
HRAG_KG_CHUNK_TOKEN_SIZE=1200
HRAG_KG_QUERY_TIMEOUT=30.0
# Graph storage backend: networkx (file-based) | neo4j
HRAG_KG_GRAPH_BACKEND=neo4j

# Ảnh & bảng
HRAG_DOCLING_IMAGES_SCALE=2.0
HRAG_MAX_IMAGES_PER_DOC=50
HRAG_MAX_TABLE_MARKDOWN_CHARS=8000


# =============================================================================
# RETRIEVAL — Vector search & reranking
# =============================================================================

HRAG_EMBEDDING_MODEL=mainguyen9/vietlegal-harrier-0.6b
HRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Embed + rerank microservice (GPU offload) ---
# When SET, EmbeddingService + RerankerService become thin HTTP clients that call
# the standalone `embed-rerank` service (container hrag-embed-rerank, :8090) instead
# of loading the models in-process. This lets the backend hold NO GPU state, so
# WEB_CONCURRENCY can scale past 1 (no longer GPU-bound). When empty (default here)
# the models are loaded locally — the service itself runs with this empty.
# In docker-compose.services.yml the backend defaults this ON
# (HRAG_EMBED_RERANK_URL=${HRAG_EMBED_RERANK_URL-http://embed-rerank:8090}); set it
# empty there to disable. Note: embed/caption/memory workers still embed LOCALLY.
HRAG_EMBED_RERANK_URL=
# HTTP timeout (seconds) for calls to the embed-rerank service
HRAG_EMBED_RERANK_TIMEOUT=30.0

# PII extraction microservice — people-agent calls this to extract phone/CCCD/BHXH
# from Vietnamese queries. Unset = skip PII extraction (fallback to regex/LLM).
# In docker-compose.services.yml the backend defaults this ON
# (PII_SERVICE_URL=${PII_SERVICE_URL-http://pii-service:8092}); set it empty to disable.
PII_SERVICE_URL=
# HTTP timeout (seconds) for calls to the PII extraction service
PII_SERVICE_TIMEOUT=5.0
# The service's own GPU concurrency ceiling (embed+rerank share the GPU) is set on
# the service container in compose via EMBED_RERANK_CONCURRENCY (default 1), NOT here.
# Số chunks fetch từ ChromaDB trước khi rerank
HRAG_VECTOR_PREFETCH=20
# Số chunks giữ lại sau reranking
HRAG_RERANKER_TOP_K=8
# Batch size cho embedding model encode() và cross-encoder reranker predict()
HRAG_EMBEDDING_BATCH_SIZE=32
HRAG_RERANKER_BATCH_SIZE=32
# Ngưỡng relevance score tối thiểu (0.0–1.0); chunk dưới ngưỡng bị loại
HRAG_MIN_RELEVANCE_SCORE=0.15
# Chế độ query KG: hybrid | local | global | naive
HRAG_DEFAULT_QUERY_MODE=hybrid

# Contextual Embeddings — Anthropic technique giảm ~35-49% retrieval failure rate
# Khi bật, mỗi chunk sẽ được Qwen3-4B sinh 1-2 câu mô tả vị trí trong tài liệu
# rồi prepend vào text trước khi embed. Content gốc vẫn được lưu để hiển thị.
# Tăng thời gian xử lý document, không ảnh hưởng tốc độ query.
# Yêu cầu MEMORY_AGENT_BASE_URL hoạt động (Qwen3-4B đang chạy).
HRAG_ENABLE_CONTEXTUAL_EMBEDDINGS=true
HRAG_CONTEXTUAL_MAX_TOKENS=120
HRAG_CONTEXTUAL_CONCURRENCY=8
# BM25 Hybrid Search
HRAG_ENABLE_BM25=true
HRAG_BM25_PREFETCH=20
HRAG_RRF_K=60
# BM25 parameters tuned for Vietnamese legal text
HRAG_BM25_K1=2.0
HRAG_BM25_B=0.5
# Recency boost: prefer newer documents based on published_date
HRAG_RECENTNESS_BOOST=0.3
HRAG_RECENTNESS_DECAY_DAYS=365
# =============================================================================
# GPU DEVICE PLACEMENT
# Kiểm soát worker nào dùng GPU, worker nào dùng CPU
#
# "auto" → dùng GPU nếu có (production, multi-GPU)
# "cpu"  → ép CPU (máy demo 1 GPU nhỏ để tránh OOM)
# "cuda" → ép GPU cụ thể
#
# CUDA_VISIBLE_DEVICES=1 → toàn bộ hệ thống (FastAPI + workers) chỉ dùng GPU 1
# Multi-GPU production: để "auto" + set CUDA_VISIBLE_DEVICES=N per container
#   parse_worker:  CUDA_VISIBLE_DEVICES=0
#   embed_worker:  CUDA_VISIBLE_DEVICES=1
#   kg_worker:     CUDA_VISIBLE_DEVICES=1  (hoặc GPU 2 nếu có)
# =============================================================================

# Ép toàn bộ process Python (FastAPI + workers) chỉ thấy GPU 1
CUDA_VISIBLE_DEVICES=1

# parse worker: Docling (LayoutModel ~1GB + TableFormer ~600MB)
HRAG_DOCLING_DEVICE=cuda

# embed worker + KG embedding: bge-m3 (~3.3GB GPU | ~4GB RAM khi cpu)
HRAG_EMBEDDING_DEVICE=cuda

# cross-encoder reranker device (mirrors HRAG_EMBEDDING_DEVICE). "auto" = GPU nếu có.
HRAG_RERANKER_DEVICE=auto


# =============================================================================
# OCR — Xử lý PDF scan (image-based PDF)
# =============================================================================

HRAG_ENABLE_OCR=true
# Tỉ lệ trang không có selectable text để phân loại là scanned PDF (0.0–1.0)
HRAG_OCR_SCANNED_THRESHOLD=0.5

# Backend OCR:
#   false (default) → remote vLLM API tại HUNYUAN_OCR_API_URL (không cần GPU local)
#   true            → local vllm.LLM trên máy (cần pip install vllm + ~4GB VRAM)
HRAG_OCR_LOCAL=false

# --- Remote API backend (HRAG_OCR_LOCAL=false) ---
HUNYUAN_OCR_API_URL=http://localhost:8001/v1
# Served-model-name của vllm-ocr — nay là Baidu Unlimited-OCR
HUNYUAN_OCR_MODEL=unlimited-ocr
# DPI render trang PDF trước khi gửi OCR (cao hơn = nét hơn nhưng ảnh nặng hơn)
HRAG_OCR_DPI=150
# Số trang OCR song song qua remote API
# (match vllm-ocr --max-num-seqs, đã tăng lên 24 sau khi dừng vllm-memory)
HRAG_OCR_CONCURRENCY=24
# HTTP read timeout (giây) cho mỗi request OCR 1 trang
HRAG_OCR_HTTP_TIMEOUT=120
# max_tokens cho mỗi lần OCR 1 trang qua API (phải < max-model-len 12288 trừ ~3.5k token ảnh)
HRAG_OCR_API_MAX_TOKENS=6144

# --- Local vLLM backend (HRAG_OCR_LOCAL=true) ---
# GPU để chạy OCR model.
# "auto" hoặc "" = không override CUDA_VISIBLE_DEVICES (inherit từ parent process)
# → Để "auto" khi đã set CUDA_VISIBLE_DEVICES=1 ở trên, tránh conflict.
# Chỉ đặt số cụ thể (0/1/2) khi KHÔNG set CUDA_VISIBLE_DEVICES ở cấp process.
HRAG_OCR_CUDA_DEVICE=auto
# Phần trăm VRAM dành cho KV cache của OCR model (Unlimited-OCR ~3B, local mode)
# Mặc định vLLM=0.9 (~43GB) sẽ conflict với LLM server đang chạy → dùng 0.15-0.5
HRAG_OCR_GPU_MEMORY_UTILIZATION=0.42
# Max sequence length — phải đặt tường minh để tránh vLLM auto-probe (thường gây
# "Engine core initialization failed" trên một số GPU/driver combo).
HRAG_OCR_MAX_MODEL_LEN=12000


# =============================================================================
# STT — Speech-to-Text (voice input cho chat mic)
# =============================================================================
STT_ENABLED=true
# Provider của lớp STT engine-agnostic (app/services/stt/):
#   faster_whisper → nạp model CTranslate2 IN-PROCESS (mặc định của config)
#   openai         → gọi endpoint OpenAI-compatible /v1/audio/transcriptions
# Trong docker-compose.services.yml backend đặt STT_PROVIDER=openai +
# STT_OPENAI_BASE_URL=http://stt:8091/v1 → route sang service `stt` (container
# hrag-stt, :8091, CPU-only) chạy faster-whisper large-v3. STT nằm CPU vì
# CTranslate2 cần CUDA 12 nhưng image ship CUDA 13.
# Revert về in-process: STT_PROVIDER=faster_whisper + để TRỐNG STT_OPENAI_BASE_URL.
STT_PROVIDER=openai
STT_LANGUAGE=vi
STT_MAX_UPLOAD_MB=25
# --- faster-whisper (khi STT_PROVIDER=faster_whisper; cũng là model host của stt sidecar) ---
STT_FW_MODEL=large-v3
STT_FW_DEVICE=auto
STT_FW_COMPUTE_TYPE=default
# --- OpenAI-compatible (khi STT_PROVIDER=openai) → trỏ vào stt sidecar ---
STT_OPENAI_BASE_URL=http://stt:8091/v1
STT_OPENAI_MODEL=whisper-1
STT_OPENAI_API_KEY=


# =============================================================================
# WORKER TIMING — Timeout per message handler (seconds)
# Parse workers need higher timeout for large scanned PDFs with OCR
# =============================================================================

WORKER_PARSE_TIMEOUT=300
WORKER_EMBED_TIMEOUT=60
# Caption: vision-LLM cho nhiều ảnh (concurrency 4) + đợi embed_done trước khi
# re-embed → 60s là quá ngắn, doc nhiều ảnh sẽ timeout/retry lặp vô ích
WORKER_CAPTION_TIMEOUT=600
# Luật lớn (~100+ Điều, LLM extract từng Điều) cần >600s — vd luat117-2025:
# 212 chunks chết đúng 600.1s. Queue KG serial theo workspace nên chấp nhận giữ
# handler lâu; hết retry thì code tự đưa doc về INDEXED kèm kg_warning.
WORKER_KG_TIMEOUT=1800

# Số LLM call đồng thời trong 1 worker process
# kg_worker: trích xuất entity/relation | caption_worker: sinh caption ảnh/bảng
HRAG_KG_LLM_CONCURRENCY=8
HRAG_CAPTION_CONCURRENCY=4

# =============================================================================
# CORS — Frontend origins được phép truy cập API
# =============================================================================

CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]

# =============================================================================
# NEO4J — Knowledge Graph backend (dùng khi HRAG_KG_GRAPH_BACKEND=neo4j)
# LightRAG đọc trực tiếp từ os.environ (không qua pydantic-settings)
# =============================================================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hrag1234

# --- Memory Agent (OpenAI-compatible proxy) ---
MEMORY_AGENT_LOCAL=false
MEMORY_AGENT_API_KEY=your-proxy-api-key

# --- LangGraph Agent ---
# "langgraph" → dùng LangGraph agent mới | "legacy" → agent cũ (default safe)
NEXUSRAG_AGENT_BACKEND=langgraph
NEXUSRAG_LG_MAX_ITERATIONS=3
NEXUSRAG_LG_USE_MEMORY_AGENT_AS_CLASSIFIER=true
NEXUSRAG_LG_CHECKPOINTER=memory

# --- Supervisor Thinking / Routing LLM ---
# Cùng proxy, model alias riêng cho supervisor intent classification & judge.
NEXUSRAG_LG_THINKING_BASE_URL=http://host.docker.internal:20128/v1
NEXUSRAG_LG_THINKING_MODEL=airag-thinking
NEXUSRAG_LG_THINKING_API_KEY=your-proxy-api-key
NEXUSRAG_LG_THINKING_FOR_JUDGE=true

# Optional fallback aliases (chỉ dùng khi NEXUSRAG_LG_THINKING_* để trống)
ANTHROPIC_BASE_URL=http://host.docker.internal:20128/v1
ANTHROPIC_AUTH_TOKEN=none
ANTHROPIC_DEFAULT_FABLE_MODEL=airag-thinking

# =============================================================================
# LANG Smith / LANG Fuse — Tracing & Observability for LangGraph Agent
# =============================================================================

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-api-key-here
LANGSMITH_PROJECT=RAG

LANGFUSE_SECRET_KEY="sk-lf-8759198e-d8ef-434a-afda-9be66a2e5136"
LANGFUSE_PUBLIC_KEY="pk-lf-6128ba06-1a0a-412c-8005-2c80435ecf4a"
LANGFUSE_BASE_URL="http://langfuse.hatinh.local"
LANGFUSE_HOST="http://langfuse.hatinh.local"
# Wrap LLM providers để mọi call được ghi vào Langfuse dạng "generation". Set false để tắt.
LANGFUSE_TRACE_LLM=true

# =============================================================================
# MONGODB — People Search (MongoDB for person records)
# =============================================================================
MONGO_HOST=10.10.0.120
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=local
MONGO_AUTH_SOURCE=
# Async driver: motor
# Example connection string: mongodb://admin:changeme@localhost:27017/?authSource=admin

# ReAct executor for RAG group (tool-aware planning)
NEXUSRAG_LG_RAG_REACT=true
# Reasoning + self-evaluation upgrade (see config.py NEXUSRAG_REACT_*)
NEXUSRAG_REACT_THINK_TOOL_TURNS=false  # off: thinking cost ~3.5s/turn nhưng không đổi tool chosen; giá trị reasoning ở sufficiency-gate + judge
NEXUSRAG_REACT_JUDGE=true              # LLM-as-judge gate before finalising
NEXUSRAG_REACT_MAX_REFLECTIONS=2       # judge→act→judge loops before forcing answer
NEXUSRAG_REACT_HISTORY_TURNS=6         # digest N lượt hội thoại trước vào system prompt ReAct (0 = tắt)
NEXUSRAG_REACT_GROUNDING_GUARD=true    # thu hồi+thay câu trả lời khi dẫn số hiệu VB không có trong nguồn & judge=revise/skip (chống bịa; false = chỉ thêm caveat)
NEXUSRAG_REACT_SUFFICIENCY_GATE=true   # memory-agent chấm nguồn có phủ câu hỏi không TRƯỚC synthesis; không phủ → trả honest-fallback, không cho model viết (chống bịa grounding-một-phần); fail-open
NEXUSRAG_REACT_SUFFICIENCY_RETRY=true  # khi gate báo thiếu & nêu rõ phần thiếu → chạy 1 search nhắm đúng phần đó rồi tái kiểm trước khi bỏ cuộc (bounded 1 lượt; cần SUFFICIENCY_GATE)
NEXUSRAG_CONDENSE_LLM_JUDGE=true       # memory-agent phán quyết follow-up (false = quay lại gate regex cũ)

# =============================================================================
# CLOUDFLARE TUNNEL — expose the webhook publicly (e.g. for Telegram)
# =============================================================================
# Token of a remotely-managed tunnel from the Cloudflare Zero Trust dashboard.
# In the dashboard add a Public Hostname routing your domain → http://hrag-backend:8080
# Start it:  docker compose -f docker-compose.services.yml --profile tunnel up -d cloudflared
# Webhook URL becomes: https://<your-domain>/api/v1/integrations/telegram/webhook
CLOUDFLARE_TUNNEL_TOKEN=

# Public origin the app is reachable at through the tunnel (matches the
# `hostname:` in cloudflared/config.yml). Backend uses it to build the Telegram
# webhook URL suggested in Settings instead of the internal http://backend:8080.
# No trailing slash.
PUBLIC_BASE_URL=https://bot.zbots.store

# =============================================================================
# FRONTEND SITE METADATA — browser title + link preview (Open Graph / Twitter)
# =============================================================================
# Filled into %VITE_*% placeholders in frontend/index.html by the Vite dev
# server / build. Passed through docker-compose.services.yml (frontend env),
# which also provides these defaults — only set here to override.
# After changing: docker compose -f docker-compose.services.yml up -d --no-deps frontend
VITE_SITE_NAME=AIRAG
VITE_SITE_TITLE=AIRAG - AI Workspace
VITE_SITE_DESCRIPTION=Trợ lý AI tra cứu kho tri thức nội bộ: tìm kiếm ngữ nghĩa, đồ thị tri thức và chat có trích dẫn nguồn từ văn bản của bạn.
# Public web-UI origin (matches the frontend `hostname:` in cloudflared/config.yml).
# Used for og:url + og:image absolute URLs. No trailing slash.
VITE_PUBLIC_URL=https://rag.zbots.store
