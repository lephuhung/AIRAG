# =============================================================================
# NexusRAG — Environment Configuration
# Copy file này thành .env và chỉnh sửa theo môi trường của bạn
# =============================================================================


# =============================================================================
# INFRASTRUCTURE — Services
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hrag

# ChromaDB (vector store)
CHROMA_HOST=localhost
CHROMA_PORT=8002

# RabbitMQ (task queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MinIO (object storage — raw uploads + parsed markdown)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=hrag-uploads
MINIO_BUCKET_MARKDOWN=hrag-markdown
MINIO_SECURE=false
# false = publish ParseMessage ngay sau upload (dev, không cần webhook)
# true  = chờ MinIO S3 event webhook tại /api/v1/minio/events (production)
MINIO_WEBHOOK_ENABLED=false
# URL MinIO mà browser có thể reach trực tiếp (dùng cho presigned PUT URL)
# Docker local dev: http://localhost:9000
# Production server: http://your-server-ip:9000 hoặc https://minio.yourdomain.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000


# =============================================================================
# LLM — Chat & KG extraction
# Chọn 1 trong 2 provider: gemini | ollama
# =============================================================================

LLM_PROVIDER=openai_compatible

# --- Gemini ---
# LLM_PROVIDER=gemini
# GOOGLE_AI_API_KEY=your-api-key-here
# LLM_MODEL_FAST=gemini-2.5-flash
# LLM_MODEL_FAST=gemini-3.1-flash-lite-preview

# --- Ollama (native Ollama protocol tại port 11434) ---
# LLM_PROVIDER=ollama
OLLAMA_HOST=http://10.10.0.240:8000/v1
OLLAMA_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# OLLAMA_MODEL=qwen3:14b        ← tốt cho KG entity extraction
# OLLAMA_MODEL=gemma3:12b       ← multimodal, tốt cho caption ảnh
# OLLAMA_MODEL=qwen3.5:9b

# --- OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp, v.v.) ---
OPENAI_COMPATIBLE_BASE_URL=http://10.10.0.240:8000/v1
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
OPENAI_COMPATIBLE_API_KEY=your-api-key-here

# Thinking mode (chỉ cho model hỗ trợ, vd qwen3.5 — giảm latency nếu tắt)
OLLAMA_ENABLE_THINKING=true

# Giới hạn output tokens (bao gồm thinking tokens nếu có)
LLM_MAX_OUTPUT_TOKENS=4096

# Thinking level cho Gemini 3.x+: minimal | low | medium | high
# (Gemini 2.5 tự động dùng thinking_budget_tokens, setting này bị bỏ qua)
LLM_THINKING_LEVEL=medium

# --- LegalKG Extraction LLM --- Dedicated model for KG entity/relation extraction
# Uses its own provider, base_url, model, and api_key
LEGAL_KG_LLM_PROVIDER=openai_compatible   # gemini | ollama | openai_compatible
LEGAL_KG_LLM_BASE_URL=http://127.0.0.1:8088/v1
LEGAL_KG_LLM_MODEL=qwen-memory
LEGAL_KG_LLM_API_KEY=your-api-key-here
# =============================================================================
# KG EMBEDDING — Vector embedding cho Knowledge Graph (LightRAG)
# Có thể dùng provider khác với LLM provider ở trên
# =============================================================================

# local  → sentence-transformers trực tiếp trên máy (khuyến nghị khi không có Gemini key)
# gemini → Gemini Embedding API (cần GOOGLE_AI_API_KEY)
# ollama → Ollama embedding API (remote host ở trên phải có embedding endpoint)
KG_EMBEDDING_PROVIDER=local
KG_EMBEDDING_MODEL=google/embeddinggemma-300m
KG_EMBEDDING_DIMENSION=1024

# --- Gemini embedding (inactive) ---
# KG_EMBEDDING_PROVIDER=gemini
# KG_EMBEDDING_MODEL=gemini-embedding-001
# KG_EMBEDDING_DIMENSION=3072


# =============================================================================
# PIPELINE — Document ingestion
# =============================================================================

# Bật/tắt các tính năng
HRAG_ENABLED=true
HRAG_ENABLE_KG=true
HRAG_ENABLE_IMAGE_EXTRACTION=true
HRAG_ENABLE_IMAGE_CAPTIONING=true
HRAG_ENABLE_TABLE_CAPTIONING=true
# Tắt CodeFormulaV2 VLM (~1.5 GB VRAM) khi không cần nhận dạng công thức toán
HRAG_ENABLE_FORMULA_ENRICHMENT=true

# Chunking
HRAG_CHUNK_MAX_TOKENS=512

# Knowledge Graph
HRAG_KG_LANGUAGE=Vietnamese
HRAG_KG_ENTITY_TYPES=["Organization","Person","Product","Location","Event","Financial_Metric","Technology","Date","Regulation"]
HRAG_KG_CHUNK_TOKEN_SIZE=1200
HRAG_KG_QUERY_TIMEOUT=30.0
# Graph storage backend: networkx (file-based) | neo4j
HRAG_KG_GRAPH_BACKEND=neo4j

# Ảnh & bảng
HRAG_DOCLING_IMAGES_SCALE=2.0
HRAG_MAX_IMAGES_PER_DOC=50
HRAG_MAX_TABLE_MARKDOWN_CHARS=8000


# =============================================================================
# RETRIEVAL — Vector search & reranking
# =============================================================================

HRAG_EMBEDDING_MODEL=mainguyen9/vietlegal-harrier-0.6b
HRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Số chunks fetch từ ChromaDB trước khi rerank
HRAG_VECTOR_PREFETCH=20
# Số chunks giữ lại sau reranking
HRAG_RERANKER_TOP_K=8
# Batch size cho embedding model encode() và cross-encoder reranker predict()
HRAG_EMBEDDING_BATCH_SIZE=32
HRAG_RERANKER_BATCH_SIZE=32
# Ngưỡng relevance score tối thiểu (0.0–1.0); chunk dưới ngưỡng bị loại
HRAG_MIN_RELEVANCE_SCORE=0.15
# Chế độ query KG: hybrid | local | global | naive
HRAG_DEFAULT_QUERY_MODE=hybrid

# Contextual Embeddings — Anthropic technique giảm ~35-49% retrieval failure rate
# Khi bật, mỗi chunk sẽ được Qwen3-4B sinh 1-2 câu mô tả vị trí trong tài liệu
# rồi prepend vào text trước khi embed. Content gốc vẫn được lưu để hiển thị.
# Tăng thời gian xử lý document, không ảnh hưởng tốc độ query.
# Yêu cầu MEMORY_AGENT_BASE_URL hoạt động (Qwen3-4B đang chạy).
HRAG_ENABLE_CONTEXTUAL_EMBEDDINGS=true
HRAG_CONTEXTUAL_MAX_TOKENS=120
HRAG_CONTEXTUAL_CONCURRENCY=8
# BM25 Hybrid Search
HRAG_ENABLE_BM25=true
HRAG_BM25_PREFETCH=20
HRAG_RRF_K=60
# BM25 parameters tuned for Vietnamese legal text
HRAG_BM25_K1=2.0
HRAG_BM25_B=0.5
# Recency boost: prefer newer documents based on published_date
HRAG_RECENTNESS_BOOST=0.3
HRAG_RECENTNESS_DECAY_DAYS=365
# =============================================================================
# GPU DEVICE PLACEMENT
# Kiểm soát worker nào dùng GPU, worker nào dùng CPU
#
# "auto" → dùng GPU nếu có (production, multi-GPU)
# "cpu"  → ép CPU (máy demo 1 GPU nhỏ để tránh OOM)
# "cuda" → ép GPU cụ thể
#
# CUDA_VISIBLE_DEVICES=1 → toàn bộ hệ thống (FastAPI + workers) chỉ dùng GPU 1
# Multi-GPU production: để "auto" + set CUDA_VISIBLE_DEVICES=N per container
#   parse_worker:  CUDA_VISIBLE_DEVICES=0
#   embed_worker:  CUDA_VISIBLE_DEVICES=1
#   kg_worker:     CUDA_VISIBLE_DEVICES=1  (hoặc GPU 2 nếu có)
# =============================================================================

# Ép toàn bộ process Python (FastAPI + workers) chỉ thấy GPU 1
CUDA_VISIBLE_DEVICES=1

# parse worker: Docling (LayoutModel ~1GB + TableFormer ~600MB)
HRAG_DOCLING_DEVICE=cuda

# embed worker + KG embedding: bge-m3 (~3.3GB GPU | ~4GB RAM khi cpu)
HRAG_EMBEDDING_DEVICE=cuda


# =============================================================================
# OCR — Xử lý PDF scan (image-based PDF)
# =============================================================================

HRAG_ENABLE_OCR=true
# Tỉ lệ trang không có selectable text để phân loại là scanned PDF (0.0–1.0)
HRAG_OCR_SCANNED_THRESHOLD=0.5

# Backend OCR:
#   false (default) → remote vLLM API tại HUNYUAN_OCR_API_URL (không cần GPU local)
#   true            → local vllm.LLM trên máy (cần pip install vllm + ~4GB VRAM)
HRAG_OCR_LOCAL=false

# --- Remote API backend (HRAG_OCR_LOCAL=false) ---
HUNYUAN_OCR_API_URL=http://localhost:8001/v1
HUNYUAN_OCR_MODEL=hunyuan-ocr
# DPI render trang PDF trước khi gửi OCR (cao hơn = nét hơn nhưng ảnh nặng hơn)
HRAG_OCR_DPI=150
# Số trang OCR song song qua remote API
HRAG_OCR_CONCURRENCY=16
# HTTP read timeout (giây) cho mỗi request OCR 1 trang
HRAG_OCR_HTTP_TIMEOUT=120
# max_tokens cho mỗi lần OCR 1 trang qua API
HRAG_OCR_API_MAX_TOKENS=8192

# --- Local vLLM backend (HRAG_OCR_LOCAL=true) ---
# GPU để chạy OCR model.
# "auto" hoặc "" = không override CUDA_VISIBLE_DEVICES (inherit từ parent process)
# → Để "auto" khi đã set CUDA_VISIBLE_DEVICES=1 ở trên, tránh conflict.
# Chỉ đặt số cụ thể (0/1/2) khi KHÔNG set CUDA_VISIBLE_DEVICES ở cấp process.
HRAG_OCR_CUDA_DEVICE=auto
# Phần trăm VRAM dành cho KV cache của OCR model (HunyuanOCR 1B chỉ cần ~7GB)
# Mặc định vLLM=0.9 (~43GB) sẽ conflict với LLM server đang chạy → dùng 0.15-0.5
HRAG_OCR_GPU_MEMORY_UTILIZATION=0.42
# Max sequence length — phải đặt tường minh để tránh vLLM auto-probe (thường gây
# "Engine core initialization failed" trên một số GPU/driver combo).
HRAG_OCR_MAX_MODEL_LEN=12000


# =============================================================================
# WORKER TIMING — Timeout per message handler (seconds)
# Parse workers need higher timeout for large scanned PDFs with OCR
# =============================================================================

WORKER_PARSE_TIMEOUT=300
WORKER_EMBED_TIMEOUT=60
WORKER_CAPTION_TIMEOUT=60
WORKER_KG_TIMEOUT=600

# Số LLM call đồng thời trong 1 worker process
# kg_worker: trích xuất entity/relation | caption_worker: sinh caption ảnh/bảng
HRAG_KG_LLM_CONCURRENCY=8
HRAG_CAPTION_CONCURRENCY=4

# =============================================================================
# CORS — Frontend origins được phép truy cập API
# =============================================================================

CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]

# Public origin của web UI (frontend) mà trình duyệt truy cập, dùng để dựng
# link mời tham gia tenant: {FRONTEND_BASE_URL}/register?invite=...
# Để trống → fallback PUBLIC_BASE_URL → Origin header → :8080→:5174 (dev).
# Không có dấu "/" ở cuối. Ví dụ production: https://service.hatinh.local
FRONTEND_BASE_URL=

# =============================================================================
# NEO4J — Knowledge Graph backend (dùng khi HRAG_KG_GRAPH_BACKEND=neo4j)
# LightRAG đọc trực tiếp từ os.environ (không qua pydantic-settings)
# =============================================================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hrag1234

# --- Memory Agent (vLLM OpenAI compatible) ---
MEMORY_AGENT_MODEL=qwen-memory
MEMORY_AGENT_BASE_URL=http://localhost:8088/v1
MEMORY_AGENT_LOCAL=false
GRAPHITI_LLM_API_KEY=sk-hrag

# --- LangGraph Agent ---
# "langgraph" → dùng LangGraph agent mới | "legacy" → agent cũ (default safe)
NEXUSRAG_AGENT_BACKEND=langgraph
NEXUSRAG_LG_MAX_ITERATIONS=3
NEXUSRAG_LG_USE_MEMORY_AGENT_AS_CLASSIFIER=true
NEXUSRAG_LG_CHECKPOINTER=memory
# ReAct executor cho nhóm RAG (tool-aware planning) — cần provider có native tool-calling
# Guard NEXUSRAG_REACT_MAX_TOOL_STEPS (mặc định 6) và NEXUSRAG_REACT_TOP_K (mặc định 8)
# lấy giá trị mặc định trong code, bỏ comment ở đây nếu muốn override.
NEXUSRAG_LG_RAG_REACT=true

# =============================================================================
# LANG Smith — Tracing & Observability for LangGraph Agent
# =============================================================================

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-api-key-here
LANGSMITH_PROJECT=RAG

# --- Langfuse (self-hosted: docker-compose.langfuse.yml) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse.hatinh.local
LANGFUSE_BASE_URL=http://langfuse.hatinh.local
# Wrap LLM providers so every call (supervisor classifier, answer generator,
# direct answer, memory agent, query analyzer/enricher) is captured in Langfuse
# as a "generation" with model, full prompt/completion, params, latency & tokens.
# These go through custom providers (not LangChain ChatModels) so without this
# the CallbackHandler sees no LLM I/O. Set false to disable.
LANGFUSE_TRACE_LLM=true

# =============================================================================
# MONGODB — People Search (MongoDB for person records)
# =============================================================================
MONGO_HOST=10.10.0.120
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=local
MONGO_AUTH_SOURCE=
# Async driver: motor
# Example connection string: mongodb://admin:changeme@localhost:27017/?authSource=admin

# =============================================================================
# CLOUDFLARE TUNNEL — expose the webhook publicly (e.g. for Telegram)
# =============================================================================
# Token of a remotely-managed tunnel from the Cloudflare Zero Trust dashboard.
# In the dashboard add a Public Hostname routing your domain → http://hrag-backend:8080
# Start it:  docker compose -f docker-compose.services.yml --profile tunnel up -d cloudflared
# The Telegram webhook URL then becomes:
#   https://<your-domain>/api/v1/integrations/telegram/webhook
# NOTE: the Telegram bot token/secret are configured in the UI (DB), NOT here.
CLOUDFLARE_TUNNEL_TOKEN=
